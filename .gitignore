# The container source IS a deliverable, so submission_template/ is tracked. It began as
# a clone of the organizers' template (TUE-ARIA/RARE25-Submission); that nested clone was
# detached to .git-upstream-template-clone/ because git cannot track files inside a nested
# repo. Nothing of ours was ever committed to it -- it held one upstream commit. Excluded
# below: model weights, the upstream test fixtures, build products.
submission_template/.git-upstream-template-clone/
submission_template/resources/
submission_template/test/
submission_template/nmodel.tar.gz
submission_package/
submission_probe/resources/
submission_probe/test/

# Local logs and large working artifacts. The code that regenerates these is
# published; the outputs are not, because they are either large or derived from
# challenge data that may not be redistributed.
logs/
*.png
*.pdf

# ...except the method report submitted to the challenge, which belongs in the public repo.
!report/RARE26_method_report.pdf

# --- This repository is published publicly. Everything below is local-only. ---

# Framework scaffolding referencing other projects
docs/rcf/
docs/project-structure/

# Third-party review material, not ours to publish
suggestion_*.txt

# Derived from the challenge data. The scripts that regenerate them are published;
# the outputs are not, because they carry challenge image ids and labels.
evc_inventory.csv
acq_features.csv
fov_crops.csv
dup_pairs.csv
hard_positives.csv
hard_negatives.csv
tta_*.csv
weights_demo.csv
folds_v1.csv
folds_v2.csv
submission_probe/probe_expected.csv

# Superseded copy of the container entry point (the Aug 5 single-arm system).
# Publishing it alongside the real one would misrepresent what was submitted.
inference/

# External mask dataset (EDD2020), not redistributed
edd_download/
edd_lesion_masks/
edd_manifest.csv
